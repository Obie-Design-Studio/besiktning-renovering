# Production på Vercel: se DEPLOY.md (identity-token + redeploy + test av ?token=)
#
# Supabase project URL — found in: Supabase Dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (public) key — safe to expose in the browser
# Found in: Supabase Dashboard → Settings → API → Project API keys → anon / public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — NEVER expose this to the browser
# Used only in server actions and server components
# Found in: Supabase Dashboard → Settings → API → Project API keys → service_role
SUPABASE_SERVICE_ROLE_KEY=

# Google AI (Gemini) API key — used server-side only to generate Swedish titles and descriptions from uploaded PDFs
# Free to use — get your key at: aistudio.google.com → Get API key
GOOGLE_AI_API_KEY=

# Identity tokens — one secret token per party. Visiting /?token=<value> sets a persistent cookie.
# Generate fresh tokens with: node -e "console.log(require('crypto').randomBytes(12).toString('base64url'))"
IDENTITY_TOKEN_TOBIAS=
IDENTITY_TOKEN_PALMENS=
IDENTITY_TOKEN_BESIKTNINGSMAN=
